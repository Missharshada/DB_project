olumn index="9" value="96"/><column index="10" value="78"/><column index="11" value="78"/><column index="12" value="87"/><column index="13" value="66"/><column index="14" value="84"/><column index="15" value="81"/><column index="16" value="119"/><column index="17" value="99"/><column index="18" value="156"/><column index="19" value="156"/></column_widths><filter_values/><conditional_formats/><row_id_formats/><display_formats/><hidden_columns/><plot_y_axes/><global_filter/></table><table schema="main" name="sqlite_sequence" show_row_id="0" encoding="" plot_x_axis="" unlock_view_pk="_rowid_" freeze_columns="0"><sort/><column_widths><column index="1" value="148"/><column index="2" value="29"/></column_widths><filter_values/><conditional_formats/><row_id_formats/><display_formats/><hidden_columns/><plot_y_axes/><global_filter/></table></browse_table_settings></tab_browse><tab_sql><sql name="SQL 1*">PRAGMA foreign_keys = ON;

-- =====================================================
-- 1. DROP EXISTING OBJECTS (Clean Setup)
-- =====================================================
DROP TABLE IF EXISTS payments;
DROP TABLE IF EXISTS reviews;
DROP TABLE IF EXISTS bookings;
DROP TABLE IF EXISTS customer_addresses;
DROP TABLE IF EXISTS worker;
DROP TABLE IF EXISTS customer;
DROP TABLE IF EXISTS admin;
DROP TABLE IF EXISTS categories;

-- =====================================================
-- 2. CATEGORIES TABLE (8 Categories from UI Home Screen)
-- =====================================================
CREATE TABLE categories (
  category_id INTEGER PRIMARY KEY AUTOINCREMENT,
  name        TEXT NOT NULL UNIQUE CHECK (LENGTH(name) &lt;= 100),
  icon_url    TEXT
);

-- =====================================================
-- 3. CUSTOMER TABLE (OAuth, SOS, &amp; Soft Delete Support)
-- =====================================================
CREATE TABLE customer (
  customer_id             INTEGER PRIMARY KEY AUTOINCREMENT,
  full_name               TEXT NOT NULL CHECK (LENGTH(full_name) BETWEEN 2 AND 100),
  email                   TEXT NOT NULL UNIQUE CHECK (LENGTH(email) BETWEEN 5 AND 150),
  mobile_number           TEXT NOT NULL UNIQUE CHECK (LENGTH(mobile_number) BETWEEN 10 AND 15),
  password_hash           TEXT, -- Nullable for Google/Apple OAuth sign-ups
  oauth_provider          TEXT DEFAULT 'email' CHECK (oauth_provider IN ('email', 'google', 'apple')),
  oauth_id                TEXT,
  profile_photo_url       TEXT,
  emergency_contact_phone TEXT, -- Backs the profile screen SOS button
  status                  TEXT DEFAULT 'active' NOT NULL CHECK (status IN ('active', 'blocked', 'deleted')),
  created_at              TEXT DEFAULT CURRENT_TIMESTAMP,
  updated_at              TEXT DEFAULT CURRENT_TIMESTAMP,
  deleted_at              TEXT -- Soft-delete timestamp for Account Settings flow
);

-- =====================================================
-- 4. WORKER TABLE (Badges, Real-Time Location &amp; Progress)
-- =====================================================
CREATE TABLE worker (
  worker_id          INTEGER PRIMARY KEY AUTOINCREMENT,
  full_name          TEXT NOT NULL CHECK (LENGTH(full_name) BETWEEN 2 AND 100),
  email              TEXT NOT NULL UNIQUE CHECK (LENGTH(email) BETWEEN 5 AND 150),
  mobile_number      TEXT NOT NULL UNIQUE CHECK (LENGTH(mobile_number) BETWEEN 10 AND 15),
  password_hash      TEXT NOT NULL,
  profile_photo_url  TEXT,
  category_id        INTEGER NOT NULL,
  experience_years   INTEGER DEFAULT 0 CHECK (experience_years &gt;= 0),
  about              TEXT CHECK (LENGTH(about) &lt;= 1000), -- Supports the About section
  price_per_hour     REAL DEFAULT 0.0 CHECK (price_per_hour &gt;= 0.0),
  id_proof_type      TEXT CHECK (id_proof_type IS NULL OR LENGTH(id_proof_type) &lt;= 30),
  id_proof_number    TEXT CHECK (id_proof_number IS NULL OR LENGTH(id_proof_number) &lt;= 50),
  
  -- UI Badges &amp; Availability
  is_verified        INTEGER DEFAULT 0 NOT NULL CHECK (is_verified IN (0, 1)),
  is_available       INTEGER DEFAULT 1 NOT NULL CHECK (is_available IN (0, 1)),
  
  -- Metrics for monthly progress dashboard and cards
  avg_rating         REAL DEFAULT 0.0 CHECK (avg_rating BETWEEN 0.0 AND 5.0),
  total_reviews      INTEGER DEFAULT 0 CHECK (total_reviews &gt;= 0),
  jobs_completed     INTEGER DEFAULT 0 CHECK (jobs_completed &gt;= 0),
  
  -- Live tracking coordinates
  current_latitude   REAL,
  current_longitude  REAL,
  
  status             TEXT DEFAULT 'active' NOT NULL CHECK (status IN ('active', 'blocked', 'deleted')),
  created_at         TEXT DEFAULT CURRENT_TIMESTAMP,
  updated_at         TEXT DEFAULT CURRENT_TIMESTAMP,
  deleted_at         TEXT,
  FOREIGN KEY (category_id) REFERENCES categories(category_id) ON DELETE RESTRICT
);

-- =====================================================
-- 5. ADMIN TABLE
-- =====================================================
CREATE TABLE admin (
  admin_id       INTEGER PRIMARY KEY AUTOINCREMENT,
  full_name      TEXT NOT NULL CHECK (LENGTH(full_name) BETWEEN 2 AND 100),
  email          TEXT NOT NULL UNIQUE CHECK (LENGTH(email) BETWEEN 5 AND 150),
  mobile_number  TEXT UNIQUE CHECK (mobile_number IS NULL OR LENGTH(mobile_number) BETWEEN 10 AND 15),
  password_hash  TEXT NOT NULL,
  role           TEXT DEFAULT 'moderator' NOT NULL CHECK (role IN ('super_admin', 'moderator', 'support')),
  status         TEXT DEFAULT 'active' NOT NULL CHECK (status IN ('active', 'blocked')),
  created_at     TEXT DEFAULT CURRENT_TIMESTAMP,
  updated_at     TEXT DEFAULT CURRENT_TIMESTAMP
);

-- =====================================================
-- 6. CUSTOMER ADDRESSES TABLE (Multiple Saved Locations)
-- =====================================================
CREATE TABLE customer_addresses (
  address_id    INTEGER PRIMARY KEY AUTOINCREMENT,
  customer_id   INTEGER NOT NULL,
  label         TEXT NOT NULL CHECK (label IN ('Home', 'Work', 'Other')),
  address_line  TEXT NOT NULL CHECK (LENGTH(address_line) &lt;= 300),
  city          TEXT NOT NULL,
  pincode       TEXT NOT NULL,
  latitude      REAL,
  longitude     REAL,
  FOREIGN KEY (customer_id) REFERENCES customer(customer_id) ON DELETE CASCADE
);

-- =====================================================
-- 7. BOOKINGS TABLE (Complete Transaction Lifecycle)
-- =====================================================
CREATE TABLE bookings (
  booking_id          INTEGER PRIMARY KEY AUTOINCREMENT,
  customer_id         INTEGER NOT NULL,
  worker_id           INTEGER NOT NULL,
  category_id         INTEGER NOT NULL,
  service_title       TEXT NOT NULL,
  customer_note       TEXT,
  service_address     TEXT NOT NULL,
  scheduled_date      TEXT NOT NULL, -- Format: YYYY-MM-DD
  scheduled_time      TEXT NOT NULL, -- Format: e.g. 09:14 PM
  status              TEXT DEFAULT 'pending' NOT NULL 
                      CHECK (status IN ('pending', 'confirmed', 'in_progress', 'completed', 'cancelled', 'rejected')),
  
  -- QR Check-in tracking
  qr_token            TEXT UNIQUE,
  qr_verified_at      TEXT,
  started_at          TEXT,
  completed_at        TEXT,
  
  -- Cancellation logic for the Cancel Ride button
  cancelled_by        TEXT CHECK (cancelled_by IS NULL OR cancelled_by IN ('customer', 'worker', 'admin')),
  cancellation_reason TEXT,
  cancellation_fee    REAL DEFAULT 0.0,
  
  created_at          TEXT DEFAULT CURRENT_TIMESTAMP,
  updated_at          TEXT DEFAULT CURRENT_TIMESTAMP,
  FOREIGN KEY (customer_id) REFERENCES customer(customer_id) ON DELETE RESTRICT,
  FOREIGN KEY (worker_id)   REFERENCES worker(worker_id)     ON DELETE RESTRICT,
  FOREIGN KEY (category_id) REFERENCES categories(category_id) ON DELETE RESTRICT
);

-- =====================================================
-- 8. PAYMENTS TABLE (Gateway Transactions &amp; Split Accounting)
-- =====================================================
CREATE TABLE payments (
  payment_id       INTEGER PRIMARY KEY AUTOINCREMENT,
  booking_id       INTEGER NOT NULL UNIQUE,
  base_amount      REAL NOT NULL CHECK (base_amount &gt;= 0.0),
  platform_fee     REAL DEFAULT 0.0 CHECK (platform_fee &gt;= 0.0),
  taxes            REAL DEFAULT 0.0 CHECK (taxes &gt;= 0.0),
  total_amount     REAL NOT NULL CHECK (total_amount &gt;= 0.0),
  worker_payout    REAL NOT NULL CHECK (worker_payout &gt;= 0.0),
  payment_method   TEXT NOT NULL CHECK (payment_method IN ('upi', 'card', 'netbanking', 'cash')),
  payment_status   TEXT DEFAULT 'unpaid' NOT NULL 
                   CHECK (payment_status IN ('unpaid', 'pending', 'paid', 'refunded', 'failed')),
  transaction_ref  TEXT UNIQUE,
  paid_at          TEXT,
  created_at       TEXT DEFAULT CURRENT_TIMESTAMP,
  FOREIGN KEY (booking_id) REFERENCES bookings(booking_id) ON DELETE CASCADE
);

-- =====================================================
-- 9. REVIEWS TABLE (Float Star Ratings)
-- =====================================================
CREATE TABLE reviews (
  review_id     INTEGER PRIMARY KEY AUTOINCREMENT,
  booking_id    INTEGER NOT NULL UNIQUE,
  customer_id   INTEGER NOT NULL,
  worker_id     INTEGER NOT NULL,
  rating        REAL NOT NULL CHECK (rating &gt;= 1.0 AND rating &lt;= 5.0),
  comment_text  TEXT CHECK (comment_text IS NULL OR LENGTH(comment_text) &lt;= 500),
  created_at    TEXT DEFAULT CURRENT_TIMESTAMP,
  FOREIGN KEY (booking_id)  REFERENCES bookings(booking_id)  ON DELETE CASCADE,
  FOREIGN KEY (customer_id) REFERENCES customer(customer_id) ON DELETE CASCADE,
  FOREIGN KEY (worker_id)   REFERENCES worker(worker_id)     ON DELETE CASCADE
);

-- =====================================================
-- 10. INDEXES
-- =====================================================
CREATE INDEX idx_worker_search      ON worker(category_id, is_available, status);
CREATE INDEX idx_bookings_worker    ON bookings(worker_id, status);
CREATE INDEX idx_bookings_customer  ON bookings(customer_id, status);
CREATE INDEX idx_payments_booking   ON payments(booking_id);
CREATE INDEX idx_reviews_worker     ON reviews(worker_id);

-- =====================================================
-- 11. TRIGGERS (Automated Ratings &amp; Job Counts)
-- =====================================================
CREATE TRIGGER trg_review_after_insert
AFTER INSERT ON reviews
BEGIN
  UPDATE worker
  SET 
    total_reviews = (SELECT COUNT(*) FROM reviews WHERE worker_id = NEW.worker_id),
    avg_rating    = (SELECT ROUND(AVG(rating), 2) FROM reviews WHERE worker_id = NEW.worker_id)
  WHERE worker_id = NEW.worker_id;
END;

CREATE TRIGGER trg_review_after_update
AFTER UPDATE OF rating, worker_id ON reviews
BEGIN
  UPDATE worker
  SET 
    total_reviews = (SELECT COUNT(*) FROM reviews WHERE worker_id = NEW.worker_id),
    avg_rating    = (SELECT ROUND(AVG(rating), 2) FROM reviews WHERE worker_id = NEW.worker_id)
  WHERE worker_id = NEW.worker_id;

  UPDATE worker
  SET 
    total_reviews = (SELECT COUNT(*) FROM reviews WHERE worker_id = OLD.worker_id),
    avg_rating    = COALESCE((SELECT ROUND(AVG(rating), 2) FROM reviews WHERE worker_id = OLD.worker_id), 0.0)
  WHERE worker_id = OLD.worker_id AND OLD.worker_id &lt;&gt; NEW.worker_id;
END;

CREATE TRIGGER trg_review_after_delete
AFTER DELETE ON reviews
BEGIN
  UPDATE worker
  SET 
    total_reviews = (SELECT COUNT(*) FROM reviews WHERE worker_id = OLD.worker_id),
    avg_rating    = COALESCE((SELECT ROUND(AVG(rating), 2) FROM reviews WHERE worker_id = OLD.worker_id), 0.0)
  WHERE worker_id = OLD.worker_id;
END;

CREATE TRIGGER trg_increment_worker_jobs
AFTER UPDATE OF status ON bookings
WHEN NEW.status = 'completed' AND OLD.status &lt;&gt; 'completed'
BEGIN
  UPDATE worker
  SET jobs_completed = jobs_completed + 1
  WHERE worker_id = NEW.worker_id;
END;

